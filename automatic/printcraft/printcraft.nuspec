    <bugTrackerUrl>https://github.com/storytold/pdfcraft/issues</bugTrackerUrl>
    <packageSourceUrl>https://github.com/MKAbuMattar/chocolatey-packages/tree/main/automatic/printcraft</packageSourceUrl>
    <docsUrl>https://getartcraft.com/apps/pdfcraft</docsUrl>
    <dependencies>
      <dependency id="pdfcraft" version="0.4.0" />
    </dependencies>
  </metadata>
</package>
