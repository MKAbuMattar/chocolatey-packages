  <metadata>
    <id>servoshell</id>
    <version>0.5.0</version>
    <title>Servo</title>
    <authors>servo</authors>
    <owners>Mohammad Abu Mattar</owners>
    <licenseUrl>https://github.com/servo/servo/blob/main/LICENSE</licenseUrl>
