    <packageSourceUrl>https://github.com/MKAbuMattar/chocolatey-packages/tree/main/automatic/rtk</packageSourceUrl>
    <docsUrl>https://www.rtk-ai.app</docsUrl>
  </metadata>
  <files>
    <file src="tools\**" target="tools" />
  </files>
</package>
