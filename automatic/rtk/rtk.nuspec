<?xml version="1.0"?>
<package xmlns="http://schemas.microsoft.com/packaging/2010/07/nuspec.xsd">
  <metadata>
    <id>rtk</id>
    <version>0.50.0</version>
    <title>rtk</title>
    <authors>rtk-ai</authors>
    <owners>Mohammad Abu Mattar</owners>
    <licenseUrl>https://github.com/rtk-ai/rtk/blob/develop/LICENSE</licenseUrl>
    <projectUrl>https://www.rtk-ai.app</projectUrl>
    <iconUrl>https://cdn.jsdelivr.net/gh/MKAbuMattar/chocolatey-packages@454cf4bc45c9937afab310953f01ef5e3dbbf0a3/icons/rtk.png</iconUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <description><![CDATA[## What is rtk?

A command line proxy that sits in front of an LLM and cuts token consumption on common
development commands, upstream reporting 60 to 90 percent on those. It is a single Rust
binary with no dependencies.
]]></description>
    <summary>rtk is a command line proxy that cuts LLM token use on common development commands.</summary>
    <releaseNotes>https://github.com/rtk-ai/rtk/releases/tag/v0.50.0</releaseNotes>
    <copyright>Copyright rtk-ai</copyright>
    <tags>rtk cli llm tokens proxy developer-tools rust</tags>
    <projectSourceUrl>https://github.com/rtk-ai/rtk</projectSourceUrl>
