<?xml version="1.0"?>
<package xmlns="http://schemas.microsoft.com/packaging/2010/07/nuspec.xsd">
  <metadata>
    <id>patent</id>
    <version>0.14.0</version>
    <title>patent</title>
    <authors>r14dd</authors>
    <owners>Mohammad Abu Mattar</owners>
    <licenseUrl>https://github.com/r14dd/patent/blob/main/LICENSE-APACHE</licenseUrl>
    <projectUrl>https://crates.io/crates/patent</projectUrl>
    <iconUrl>https://cdn.jsdelivr.net/gh/MKAbuMattar/chocolatey-packages@main/icons/patent.png</iconUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <description><![CDATA[## What is patent?

A prior-art search for developer tool ideas. You describe what you are thinking of
building and it looks for projects that already ship it, so you find out before writing
the code rather than after.

It runs on the command line and uses embeddings, either through Ollama locally or a
hosted model.
]]></description>
    <summary>patent is a prior-art search for developer tool ideas, checking whether something you plan to build already exists.</summary>
    <releaseNotes>https://github.com/r14dd/patent/releases/tag/v0.14.0</releaseNotes>
    <tags>patent cli developer-tools search embeddings rust</tags>
    <projectSourceUrl>https://github.com/r14dd/patent</projectSourceUrl>
    <bugTrackerUrl>https://github.com/r14dd/patent/issues</bugTrackerUrl>
    <packageSourceUrl>https://github.com/MKAbuMattar/chocolatey-packages/tree/main/automatic/patent</packageSourceUrl>
    <docsUrl>https://github.com/r14dd/patent#readme</docsUrl>
  </metadata>
  <files>
    <file src="tools\**" target="tools" />
  </files>
</package>
