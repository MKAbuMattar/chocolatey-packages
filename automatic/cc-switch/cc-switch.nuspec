    <packageSourceUrl>https://github.com/MKAbuMattar/chocolatey-packages/tree/main/automatic/cc-switch</packageSourceUrl>
    <docsUrl>https://ccswitch.io</docsUrl>
  </metadata>
  <files>
    <file src="tools\**" target="tools" />
  </files>
</package>
